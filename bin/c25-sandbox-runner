#!/bin/bash
# C25 AUTOMATED SANDBOX RUNNER
# Usage: c25-sandbox-runner <directory> [--gamma] [--all-agents]

set -euo pipefail

TARGET="${1:-.}"
MODE="${2:---quick}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
SANDBOX_ID="sandbox_${TIMESTAMP}"
SANDBOX_PATH="/sdcard/C25_Agents/sandbox/$SANDBOX_ID"

echo "🏖️  C25 SANDBOX RUNNER"
echo "======================"
echo "Target: $TARGET"
echo "Mode: $MODE"
echo "Sandbox: $SANDBOX_PATH"
echo ""

mkdir -p "$SANDBOX_PATH"/{logs,reports,builds}

# Function to run agent on file
run_agent_on_file() {
    local file="$1"
    local agent_id="$2"
    local output_file="$3"
    
    bash "$HOME/.c25_mcp/agents/$agent_id/run.sh" "sandbox $file" > "$output_file" 2>&1 || true
}

# Quick mode: Sample files with key agents
if [[ "$MODE" == "--quick" ]]; then
    echo "⚡ Quick mode: Sampling files..."
    
    find "$TARGET" -type f \( -name "*.js" -o -name "*.py" -o -name "*.sh" -o -name "*.ts" \) | head -20 | while read file; do
        echo "📄 Processing: $file"
        file_name=$(basename "$file")
        file_dir="$SANDBOX_PATH/$(dirname "${file#$TARGET/}")"
        mkdir -p "$file_dir"
        
        # Run key agents (1, 7, 12, 14, 25)
        for agent in agent-01 agent-07 agent-12 agent-14 agent-25; do
            run_agent_on_file "$file" "$agent" "$file_dir/${file_name}.${agent}.log" &
        done
    done
    
    wait
    echo "✅ Quick sandbox complete"

# Full mode: All files with all agents
elif [[ "$MODE" == "--all-agents" || "$MODE" == "--full" ]]; then
    echo "🔍 Full mode: All agents on all files..."
    
    TOTAL_FILES=$(find "$TARGET" -type f | wc -l)
    CURRENT=0
    
    find "$TARGET" -type f | while read file; do
        CURRENT=$((CURRENT + 1))
        echo "[$CURRENT/$TOTAL_FILES] Processing: $file"
        
        file_name=$(basename "$file")
        file_dir="$SANDBOX_PATH/$(dirname "${file#$TARGET/}")"
        mkdir -p "$file_dir"
        
        # Run all 25 agents
        for i in $(seq -w 01 25); do
            agent_id="agent-$i"
            run_agent_on_file "$file" "$agent_id" "$file_dir/${file_name}.${agent_id}.log" &
        done
        
        wait  # Wait for all agents on this file
    done
    
    echo "✅ Full sandbox complete"

# Gamma mode: Run through constellation25 pipeline
elif [[ "$MODE" == "--gamma" ]]; then
    echo "🌌 Gamma Constellation25 mode..."
    
    find "$TARGET" -type f | while read file; do
        echo "🌠 Gamma processing: $file"
        
        gamma_dir="$SANDBOX_PATH/gamma/$(dirname "${file#$TARGET/}")"
        mkdir -p "$gamma_dir"
        
        # Phase 1: Analysis (Agents 1-8)
        echo "  Phase 1: Static Analysis"
        for i in $(seq -w 01 08); do
            run_agent_on_file "$file" "agent-$i" "$gamma_dir/$(basename $file).phase1.agent-$i.log" &
        done
        wait
        
        # Phase 2: Build (Agents 9-16)
        echo "  Phase 2: Build & Integration"
        for i in $(seq -w 09 16); do
            run_agent_on_file "$file" "agent-$i" "$gamma_dir/$(basename $file).phase2.agent-$i.log" &
        done
        wait
        
        # Phase 3: Test (Agents 17-25)
        echo "  Phase 3: Testing & Validation"
        for i in $(seq -w 17 25); do
            run_agent_on_file "$file" "agent-$i" "$gamma_dir/$(basename $file).phase3.agent-$i.log" &
        done
        wait
        
        echo "  ✅ Gamma complete for: $file"
    done
    
    echo "✅ Gamma constellation complete"
fi

# Generate master report
echo ""
echo "📊 Generating master report..."

cat > "$SANDBOX_PATH/MASTER_REPORT.md" << MDEOF
# C25 Sandbox Master Report

**Target**: $TARGET
**Mode**: $MODE
**Created**: $(date)
**Sandbox ID**: $SANDBOX_ID

## Summary
- Total Files: $(find "$SANDBOX_PATH" -type f -name "*.log" | wc -l) logs generated
- Agents Used: 25
- Output Path: $SANDBOX_PATH

## Structure
\`\`\`
$SANDBOX_PATH/
├── logs/          # Agent execution logs
├── reports/       # Consolidated reports
├── builds/        # Build artifacts
└── gamma/         # Gamma constellation outputs (if --gamma mode)
\`\`\`

## Next Steps
1. Review individual agent logs
2. Check for errors in reports/
3. Deploy successful builds from builds/

---
*Generated by C25 Sandbox Runner*
MDEOF

echo ""
echo "========================================="
echo "✅ SANDBOX COMPLETE"
echo "========================================="
echo "📂 Location: $SANDBOX_PATH"
echo "📄 Report: $SANDBOX_PATH/MASTER_REPORT.md"
echo "🔍 View in ranger: ranger $SANDBOX_PATH"
echo "========================================="
